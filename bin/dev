#!/bin/sh
# The one place dev scrubs a caller's env (test/dev/bin_dev_test.rb
# guards it).
#
# What: the keys a bundler activation exports. A harness running dev
# under `bundle exec` leaks RUBYOPT=-r.../bundler/setup and BUNDLE_* into
# every child, and the interpreter acts on RUBYOPT before the Ruby half
# runs a single line — dev would boot inside the caller's bundle and fail
# to load its own gems. No caller's activation is ever wanted: dev picks
# its own gems (the Ruby half, below) and its children run under the
# project's shadowenv.
#
# Where: here, in the sh layer, ahead of the version probe (which would
# itself crash under a hostile RUBYOPT), and nowhere else. Scrubbing once
# at the entrypoint protects every spawn dev ever makes; per-spawn lists
# drift. The list is the source of truth: bin_dev_test parses this line
# and checks it against what the locked bundler actually exports, so a new
# bundler key shows up as a failing test, not a leak.
#
# What stays: GEM_HOME and GEM_PATH. They are the caller's gem environment
# — in a project shell, the project's activation. dev does not need them
# cleared for itself (an installed dev selects its vendored gems
# in-process, below, so the env cannot misdirect it) and must not clear
# them for its children (they inherit the activation, and in a shell with
# none the project's shadowenv sets both before anything runs under it).
unset RUBYOPT RUBYLIB BUNDLE_GEMFILE BUNDLE_LOCKFILE BUNDLE_PATH \
  BUNDLE_APP_CONFIG BUNDLE_BIN BUNDLE_BIN_PATH BUNDLER_VERSION BUNDLER_SETUP

# Use PATH ruby (rbenv) if >= 3.1, fall back to Homebrew Ruby for bootstrapping.
# dev uses Ruby 3.1+ syntax (e.g. hash literal value omission).
if command -v ruby >/dev/null 2>&1; then
  if ruby -e 'exit(Gem::Version.new(RUBY_VERSION) >= Gem::Version.new("3.1") ? 0 : 1)' 2>/dev/null; then
    exec ruby -x "$0" "$@"
  fi
fi
if command -v brew >/dev/null 2>&1; then
  brew_ruby="$(brew --prefix ruby 2>/dev/null)/bin/ruby"
  if [ -x "$brew_ruby" ]; then
    exec "$brew_ruby" -x "$0" "$@"
  fi
fi
echo "dev: no ruby found. Install rbenv and a Ruby version, or brew install ruby." >&2
exit 1

#!ruby
# frozen_string_literal: true

# Resolve symlink so Homebrew's bin/dev finds libexec/dev/lib. When this file is in bin/, it is at repo root.
script_dir = File.dirname(File.realpath(__FILE__))
root = (File.basename(script_dir) == "bin") ? File.dirname(script_dir) : script_dir
lib = File.join(root, "lib")
$LOAD_PATH.unshift(lib) unless $LOAD_PATH.include?(lib)

# An installed dev's runtime gems (sorbet-runtime, cli-ui) are vendored by
# the formula into the libexec that holds this tree — libexec/dev/bin/dev
# beside libexec/specifications. Select them here, in-process, before the
# first gem require: Gem.use_paths sets this process's gem home and path
# and touches ENV not at all, so nothing is exported for children to
# inherit (an exported GEM_HOME would send a project's bundler install
# into dev-core's Cellar) and nothing the caller exported can misdirect
# dev (a GEM_PATH-less brew Ruby falls back to the prefix-wide gem dir
# shared by every brew Ruby, where another Ruby's native extensions
# live). The vendored dir goes in FRONT of the path dev would otherwise
# have (the caller's GEM_PATH, or the Ruby's defaults when none) — never
# instead of it: default gems (json, open3) resolve from the Ruby's stdlib
# regardless of Gem.path, but *bundled* gems (reline, and readline on it —
# what CLI::UI::Prompt requires on every tty or CI run) live in the Ruby's
# gem dir and are only reachable through the path. A source checkout has
# no specifications dir beside it and keeps the shell's gem env untouched.
# Guarded by test/dev/bin_dev_test.rb against a synthetic libexec, both
# ways.
vendored = File.dirname(root)
Gem.use_paths(vendored, [vendored, *Gem.path]) if File.directory?(File.join(vendored, "specifications"))

require "dev"
require "dev/cli/global_dispatch"
require "dev/shared_umask"

# On Linux the data root is one tree shared by two OS users through a
# group; dev and everything it spawns write it group-writable.
Dev::SharedUmask.apply!

# The Ui tier is one process-wide choice, made before anything that may
# ask or report runs — the global builtins included (plan, learnings,
# skills; `cred get` onboards a first-time credential at the terminal,
# `engine down` confirms), so it is chosen ahead of their dispatch, not
# after. The StdoutRouter is the Ui's to turn on, with its first frame —
# never here.
ui = if $stdout.tty? || ENV["CI"] || ENV["CLICOLOR_FORCE"]
  Dev::Cli::UiImpl.new(cli_ui: CLI::UI)
else
  Dev::NoUi.new
end

# Global builtins (see Dev::Cli::GlobalCatalog) dispatch before any dev.yml
# lookup — they are host- or workspace-global, not project commands. Help
# flags are the Runner's.
global_dispatch = Dev::Cli::GlobalDispatch.new(ui: ui)
if global_dispatch.global_command?(ARGV)
  global_dispatch.run(ARGV)
  exit 0
end

# The Runner is project-optional and owns the rescue-to-exit mapping of the
# CLI boundary; nothing to handle here.
Dev::Cli::Runner.new(ui: ui).run(ARGV)
